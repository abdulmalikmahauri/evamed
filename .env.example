# ============================================================================
# EVAMED — переменные окружения
#
# Скопируйте в .env.local и меняйте там. Все значения по умолчанию безопасны:
# при пустом файле сайт работает как витрина без приёма данных.
#
# ВАЖНО: страницы пререндерятся на сборке, поэтому после изменения любого
# значения нужна пересборка (npm run build), а не только перезапуск.
# ============================================================================

# ---------------------------------------------------------------------------
# ПУБЛИКАЦИЯ
# ---------------------------------------------------------------------------
# Открывает сайт поисковым системам: снимает noindex и наполняет карту сайта.
# Включать только когда опубликован правовой раздел и получены реквизиты
# лицензии — до этого в разделе «Сведения» стоит «Уточняется», и индексация
# закрепит это состояние в выдаче.
EVAMED_PUBLIC=false

# Канонический адрес: https, без www и без завершающего слэша.
EVAMED_SITE_URL=https://evamed.ru

# ---------------------------------------------------------------------------
# ПРИЁМ ЗАЯВОК
# ---------------------------------------------------------------------------
# Включает отправку форм.
#
# ЮРИДИЧЕСКОЕ УСЛОВИЕ: включать только после подачи уведомления в Роскомнадзор
# о намерении обрабатывать персональные данные и назначения ответственного
# за обработку (ТЗ 20.16). До уведомления приём имени и телефона образует
# состав правонарушения, и это решение заказчика, а не разработчика.
EVAMED_FORMS=false

# Куда уходит заявка: none | webhook
#   none    — заявка проверяется, посетитель видит подтверждение,
#             НИЧЕГО не сохраняется и никуда не передаётся.
#             В журнал пишется только факт обращения без данных.
#             Этот режим позволяет показать весь путь заявки, ничего не обрабатывая.
#   webhook — POST в указанный адрес (МИС, CRM, интеграционный шлюз).
LEADS_SINK=none

# Адрес приёмника и токен. Обязательны при LEADS_SINK=webhook.
# Адрес должен быть в российской юрисдикции: передача персональных данных
# на зарубежный сервис — трансграничная передача со своими требованиями.
# LEADS_WEBHOOK_URL=https://crm.example.ru/hooks/evamed
# LEADS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# ФУНКЦИОНАЛЬНОСТЬ, У КОТОРОЙ ЕЩЁ НЕТ ОСНОВЫ
#
# Эти переключатели не включают возможность, а снимают заглушку. Включать их
# можно только вместе с появлением того, что за ними стоит, иначе посетитель
# увидит нерабочий интерфейс.
# ---------------------------------------------------------------------------

# Реальное расписание вместо заявки. Требует выбранной МИС и адаптера (ТЗ 20.15).
EVAMED_SCHEDULE=false

# Онлайн-оплата. Требует договора эквайринга и онлайн-кассы по 54-ФЗ (ТЗ 20.12).
# Пока выключено, на страницах тарифов запрещены слова «купить» и «оплатить».
EVAMED_PAYMENTS=false

# Публикация состава и цен тарифов. Требует утверждения врачом (ТЗ 20.5).
EVAMED_PROGRAM_COMPOSITION=false

# Личный кабинет. Отдельное приложение, в первой очереди не разрабатывается.
EVAMED_PATIENT_AREA=false

# Медицинские документы в кабинете. Требует защищённого контура ИСПДн (ТЗ 20.2).
# Включается только вместе с ним, отдельно — нет.
EVAMED_MEDICAL_DATA=false
